{
  "name": "fib-retracement",
  "version": "1.0.0",
  "description": "A tool for calculating fibonacci retracement and extension levels",
  "keywords": [
    "fib",
    "fibextension",
    "fibonacci",
    "fibonacciextension",
    "fibonacciretrace",
    "fibonacciretracement",
    "fibonaccitrace",
    "fibretrace",
    "fibretracement",
    "fibtrace",
    "technical-analysis",
    "trading"
  ],
  "homepage": "https://github.com/madeiras/fib-retracement",
  "bugs": "https://github.com/madeiras/fib-retracement/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madeiras/fib-retracement.git"
  },
  "license": "MIT",
  "author": {
    "name": "Joao Pereira",
    "email": "joaohrpereira@gmail.com",
    "url": "https://github.com/madeiras"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  }
}
